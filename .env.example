PORT=54111

MAIN_SERVER=user@1.1.1.1:/home/user/data
MAIN_USER_PASS=
MAIN_USER_KEY_FILE=/home/user/.ssh/id_rsa

SERVER_1=user@1.1.1.2:/home/user/data
SERVER_1_PASS=
SERVER_1_KEY_FILE=/home/user/.ssh/id_rsa

SERVER_2=user@1.1.1.3:/home/user/data
SERVER_2_PASS=1234567890
SERVER_2_KEY_FILE=

# Local DATA_DIR (always flat) is processed first, then SERVER_1, SERVER_2, ...
BATCH_SIZE=100
CONCURRENCY=10

# Full path to the local data directory (always flat)
DATA_DIR=/home/user/storage-server/data

# 0/unset = push files to MAIN_SERVER (old logic)
# 1 = ignore MAIN_SERVER and pull files from SERVER_N into DATA_DIR
MAIN_SERVER_HERE=0
# HMAC secret for Authorization Bearer JWT (1 hour lifetime, empty payload)
JWT_SALT=change-me

# TLS (run ./generate-ssl.sh). Peer servers must trust the same CA.
SSL_KEY=certs/server.key
SSL_CERT=certs/server.crt
SSL_CA=certs/ca.crt
